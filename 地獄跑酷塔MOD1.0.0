-- ==========================================
-- 1. 建立 UI 介面與左上角水印
-- ==========================================
if game.CoreGui:FindFirstChild("TowerFlyUI") then
    game.CoreGui.TowerFlyUI:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "TowerFlyUI"
ScreenGui.Parent = game.CoreGui

local Watermark = Instance.new("TextLabel")
Watermark.Size = UDim2.new(0, 250, 0, 35)
Watermark.Position = UDim2.new(0, 80, 0, 10)
Watermark.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
Watermark.BackgroundTransparency = 0.3
Watermark.Text = "t.me/xiaoJiaNB6667"
Watermark.TextColor3 = Color3.fromRGB(255, 255, 255)
Watermark.TextSize = 20
Watermark.Font = Enum.Font.FredokaOne
Watermark.Parent = ScreenGui

-- 主面板
local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 240, 0, 350) 
MainFrame.Position = UDim2.new(0.5, -120, 0.4, -175)
MainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
MainFrame.BorderColor3 = Color3.fromRGB(0, 255, 255)
MainFrame.BorderSizePixel = 2
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 30)
Title.BackgroundColor3 = Color3.fromRGB(0, 100, 100)
Title.Text = "🦸‍♂️ 地獄塔多功能"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Parent = MainFrame

local function createBtn(text, posY, bgColor)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.8, 0, 0, 40)
    btn.Position = UDim2.new(0.1, 0, 0, posY)
    btn.BackgroundColor3 = bgColor or Color3.fromRGB(50, 50, 50)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextScaled = true
    btn.Parent = MainFrame
    return btn
end

-- 按鈕配置
local FlyBtn = createBtn("點我啟動飛行", 35)
local UpBtn = createBtn("⬆️ 上升", 85, Color3.fromRGB(50, 150, 50))
UpBtn.Size = UDim2.new(0.35, 0, 0, 40); UpBtn.Position = UDim2.new(0.1, 0, 0, 85); UpBtn.Visible = false

local DownBtn = createBtn("⬇️ 下降", 85, Color3.fromRGB(150, 50, 50))
DownBtn.Size = UDim2.new(0.35, 0, 0, 40); DownBtn.Position = UDim2.new(0.55, 0, 0, 85); DownBtn.Visible = false

local CombinedMapBtn = createBtn("🩸 滿版水印: 關閉", 135, Color3.fromRGB(100, 50, 50))

-- 🎁 驚喜按鈕
local SurpriseBtn = createBtn("🎁 驚喜", 185, Color3.fromRGB(200, 50, 200))

-- 🚀 傳送功能 UI
local TeleportInput = Instance.new("TextBox")
TeleportInput.Size = UDim2.new(0.4, 0, 0, 35)
TeleportInput.Position = UDim2.new(0.1, 0, 0, 235)
TeleportInput.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
